# ---------------------------------------------------------------------------
# CLUSTER VALIDATION (workflow/rules/cluster_validation.smk)
# ---------------------------------------------------------------------------

# upstream rule: clustree_analysis (content = default)
[[rules]]
name = "clustree_analysis_default"
input = [
    "{config.result_path}/unsupervised_analysis/{sample}/metadata_clusterings.csv",
    "{config.data_dir}/{sample}_labels.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/clustree/default.png"]
description = "Clustree analysis of clusterings (default)"
script = "scripts/clustree.R --clusterings {input[0]} --metadata {input[1]} --out {output} --content default --count-filter {config.clustree_count_filter} --prop-filter {config.clustree_prop_filter} --layout {config.clustree_layout} --cat-label {config.clustree_categorical_label_option} --num-aggr {config.clustree_numerical_aggregation_option} --custom-metadata {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clustree.yaml"

# upstream rule: clustree_analysis (content = custom)
[[rules]]
name = "clustree_analysis_custom"
input = [
    "{config.result_path}/unsupervised_analysis/{sample}/metadata_clusterings.csv",
    "{config.data_dir}/{sample}_labels.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/clustree/custom.png"]
description = "Clustree analysis of clusterings with custom metadata"
script = "scripts/clustree.R --clusterings {input[0]} --metadata {input[1]} --out {output} --content custom --count-filter {config.clustree_count_filter} --prop-filter {config.clustree_prop_filter} --layout {config.clustree_layout} --cat-label {config.clustree_categorical_label_option} --num-aggr {config.clustree_numerical_aggregation_option} --custom-metadata {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clustree.yaml"

# upstream rule: clustree_analysis_metadata (content = metadata)
[[rules]]
name = "clustree_analysis_metadata"
input = [
    "{config.result_path}/unsupervised_analysis/{sample}/metadata_clusterings.csv",
    "{config.data_dir}/{sample}_labels.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/clustree/metadata"]
description = "Clustree analysis highlighting metadata"
script = "scripts/clustree.R --clusterings {input[0]} --metadata {input[1]} --out {output} --content metadata --count-filter {config.clustree_count_filter} --prop-filter {config.clustree_prop_filter} --layout {config.clustree_layout} --cat-label {config.clustree_categorical_label_option} --num-aggr {config.clustree_numerical_aggregation_option} --custom-metadata {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clustree.yaml"

