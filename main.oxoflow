    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_Homogeneity.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_Completeness.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_V.csv",
]
description = "External cluster validation indices (AMI, ARI, FMI, Homogeneity, Completeness, V)"
script = "scripts/validation_external.py --metadata {input[0]} --clusterings {input[1]} --outputs {output[0]} {output[1]} {output[2]} {output[3]} {output[4]} {output[5]}"
