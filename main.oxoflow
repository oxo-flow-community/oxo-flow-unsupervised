    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_var.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_Dunn.csv"]
description = "Internal cluster validation (Dunn)"
script = "scripts/validation_internal.R --metadata {input[0]} --clusterings {input[1]} --pca {input[2]} --pca-var {input[3]} --out {output} --internal-index Dunn --sample-proportion {config.sample_proportion} --metadata-of-interest {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clusterCrit.yaml"
[rules.resources]
memory = "32000M"

# upstream rule: validation_internal (index = C_index)
[[rules]]
name = "validation_internal_C_index"
input = [
    "{config.data_dir}/{sample}_labels.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/metadata_clusterings.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_data.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_var.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_C_index.csv"]
description = "Internal cluster validation (C-index)"
script = "scripts/validation_internal.R --metadata {input[0]} --clusterings {input[1]} --pca {input[2]} --pca-var {input[3]} --out {output} --internal-index C_index --sample-proportion {config.sample_proportion} --metadata-of-interest {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clusterCrit.yaml"
[rules.resources]
memory = "32000M"

# upstream rule: validation_internal (index = Davies_Bouldin)
[[rules]]
name = "validation_internal_Davies_Bouldin"
input = [
    "{config.data_dir}/{sample}_labels.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/metadata_clusterings.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_data.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_var.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_Davies_Bouldin.csv"]
description = "Internal cluster validation (Davies-Bouldin)"
script = "scripts/validation_internal.R --metadata {input[0]} --clusterings {input[1]} --pca {input[2]} --pca-var {input[3]} --out {output} --internal-index Davies_Bouldin --sample-proportion {config.sample_proportion} --metadata-of-interest {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clusterCrit.yaml"
[rules.resources]
memory = "32000M"

# upstream rule: validation_internal (index = BIC)
[[rules]]
name = "validation_internal_BIC"
input = [
    "{config.data_dir}/{sample}_labels.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/metadata_clusterings.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_data.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/PCA/PCA_{config.pca_svd_solver}_{config.pca_n_components}_var.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_BIC.csv"]
description = "Internal cluster validation (BIC)"
script = "scripts/validation_internal.R --metadata {input[0]} --clusterings {input[1]} --pca {input[2]} --pca-var {input[3]} --out {output} --internal-index BIC --sample-proportion {config.sample_proportion} --metadata-of-interest {config.metadata_of_interest}"
[rules.environment]
conda = "envs/clusterCrit.yaml"
[rules.resources]
memory = "32000M"

# upstream rule: aggregate_rank_internal (TOPSIS MCDM ranking)
[[rules]]
name = "aggregate_rank_internal"
input = []
expand_inputs = [
    { pattern = "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_Silhouette.csv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_Calinski_Harabasz.csv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_Dunn.csv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_C_index.csv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_Davies_Bouldin.csv", variables = { sample = "config.samples_list" } },
    { pattern = "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_index_BIC.csv", variables = { sample = "config.samples_list" } },
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_indices_ranked.csv"]
description = "Rank internal cluster indices with TOPSIS (MCDM)"
script = "scripts/mcdm_topsis.py --inputs {input} --out {output}"
[rules.environment]
conda = "envs/pymcdm.yaml"

# upstream rule: plot_indices (type = external)
[[rules]]
name = "plot_indices_external"
input = [
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_AMI.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_ARI.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_FMI.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_Homogeneity.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_Completeness.csv",
    "{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/external_index_V.csv",
]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/plots/external"]
description = "Heatmaps of external cluster indices"
script = "scripts/plot_indices.R --type external --paths {input} --out {output}"
[rules.environment]
conda = "envs/ggplot.yaml"

# upstream rule: plot_indices (type = internal)
[[rules]]
name = "plot_indices_internal"
input = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/internal_indices_ranked.csv"]
output = ["{config.result_path}/unsupervised_analysis/{sample}/cluster_validation/plots/internal"]
description = "Heatmap of ranked internal cluster indices"
script = "scripts/plot_indices.R --type internal --paths {input} --out {output}"
[rules.environment]
conda = "envs/ggplot.yaml"

# ---------------------------------------------------------------------------
# EXPORT (workflow/rules/envs_export.smk: annot_export; env_export and
# config_export are not ported — see README fidelity table)
# ---------------------------------------------------------------------------

# upstream rule: annot_export (annotation copy for reproducibility)
[[rules]]
name = "annot_export"
input = ["config/annotation.csv"]
output = ["{config.result_path}/unsupervised_analysis/configs/{config.project_name}_annot.csv"]
description = "Copy the annotation file for documentation and reproducibility"
shell = "cp {input} {output}"
